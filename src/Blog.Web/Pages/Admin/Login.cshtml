@page "/admin/login"
<section class="login-panel"><p class="eyebrow">ALWAYS CURIOUS</p><h1>登录内容管理</h1><form id="login-form"><label>用户名<input name="userName" autocomplete="username" required maxlength="100"/></label><label>密码<input name="password" type="password" autocomplete="current-password" required maxlength="1024"/></label><button type="submit">登录</button><p id="login-error" role="alert"></p></form></section>
