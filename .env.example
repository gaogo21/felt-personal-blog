# Development example only. Keep actual values outside Git.
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_PORT=55432
APP_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
Blog__AdminName=admin
Blog__AdminPassword=replace-with-at-least-12-characters
# Production requires a base64 32-byte key; store a copy separately from backups.
Backup__Key=
# Production: set the actual trusted reverse proxy IP and host name.
ReverseProxy__KnownProxy=
AllowedHosts=localhost;127.0.0.1
